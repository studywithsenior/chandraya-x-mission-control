# Copy this file to .env.local and fill in values from your EMQX deployment.
# Browser-side VITE_ variables are visible to visitors. Use ONLY a read-only MQTT account.
VITE_MQTT_WS_URL=wss://YOUR-EMQX-HOST:8084/mqtt
VITE_MQTT_READONLY_USERNAME=YOUR_READ_ONLY_USERNAME
VITE_MQTT_READONLY_PASSWORD=YOUR_READ_ONLY_PASSWORD
